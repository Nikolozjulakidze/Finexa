# Database
DATABASE_URL=postgres://user:password@localhost:5432/IncomeVisor

# JWT
JWT_SECRET=your_jwt_secret_here

# Google OAuth (Web client ID for your app)
# Create at https://console.cloud.google.com/apis/credentials
# Add your authorized JavaScript origins (e.g. http://localhost:5173)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional: Gemini for AI features
GEMINI_API_KEY=your_gemini_api_key

# Google reCAPTCHA v2 secret key (from the same reCAPTCHA project)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# SMTP for sending OTP emails (e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_password
SMTP_FROM=your_email@gmail.com
