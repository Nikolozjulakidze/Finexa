# Google OAuth Web Client ID (must match the backend GOOGLE_CLIENT_ID)
# Create at https://console.cloud.google.com/apis/credentials
# Add your app's origin (e.g. http://localhost:5173) to authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google reCAPTCHA v2 - create at https://www.google.com/recaptcha/admin/create
# Choose "I'm not a robot" Checkbox (v2). Add localhost to domains.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
